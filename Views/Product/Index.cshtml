@model List<inventory_management_module.Models.Product>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inventory Management</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f4f1ea; margin: 0; color: #2b2b2b; }
        .header { background: #2f3e46; color: #fff; padding: 16px 32px; }
        .header h4 { margin: 0; font-family: Cambria, serif; font-weight: 500; line-height: 1.6; }
        .container { max-width: 960px; margin: 28px auto; padding: 0 16px; }
        .card { background: #fff; border-radius: 10px; padding: 24px; box-shadow: 0 2px 10px rgba(0,0,0,.08); }
        .top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; flex-wrap: wrap; gap: 10px; }
        .top h2 { margin: 0; }
        .btn { display: inline-block; padding: 8px 16px; border-radius: 6px; border: none; font-size: 14px; cursor: pointer; text-decoration: none; font-family: inherit; }
        .btn-primary { background: #2a9d8f; color: #fff; }
        .btn-primary:hover { background: #21867a; }
        .btn-edit { background: #e9c46a; color: #333; }
        .btn-edit:hover { background: #dcb552; }
        .btn-delete { background: #e76f51; color: #fff; }
        .btn-delete:hover { background: #d25a3c; }
        table { width: 100%; border-collapse: collapse; }
        th { background: #264653; color: #fff; text-align: left; padding: 12px; font-weight: 600; }
        td { padding: 12px; border-bottom: 1px solid #eee; }
        tbody tr:hover { background: #f9f7f2; }
        .num { text-align: right; }
        .actions { display: flex; gap: 8px; align-items: center; }
        .actions form { margin: 0; }
        .badge { padding: 3px 9px; border-radius: 12px; font-size: 12px; font-weight: 600; }
        .badge-ok { background: #d8f3dc; color: #1b663a; }
        .badge-low { background: #ffe1d6; color: #a63d1c; }
        .empty { text-align: center; padding: 40px 0; color: #777; }
    </style>
</head>
<body>
    <div class="header">
        <h4>
            Name: Daxrajsinh Zala <br />
            Enrolment No: 92400120444
        </h4>
    </div>

    <div class="container">
        <div class="card">
            <div class="top">
                <h2>Inventory Management</h2>
                @Html.ActionLink("+ Add New Product", "Create", null, new { @class = "btn btn-primary" })
            </div>

            @if (Model.Count == 0)
            {
                <div class="empty">No products yet. Click "Add New Product" to get started.</div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Product Name</th>
                            <th class="num">Quantity</th>
                            <th class="num">Price</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ProductID</td>
                                <td>@item.ProductName</td>
                                <td class="num">
                                    @item.Quantity
                                    @if (item.Quantity < 5)
                                    {
                                        <span class="badge badge-low">Low stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-ok">In stock</span>
                                    }
                                </td>
                                <td class="num">@item.Price.ToString("N2")</td>
                                <td>
                                    <div class="actions">
                                        @Html.ActionLink("Edit", "Edit", new { id = item.ProductID }, new { @class = "btn btn-edit" })

                                        @using (Html.BeginForm("Delete", "Product", new { id = item.ProductID }, FormMethod.Post, new { onsubmit = "return confirm('Delete this product?');" }))
                                        {
                                            <input type="submit" value="Delete" class="btn btn-delete" />
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</body>
</html>
